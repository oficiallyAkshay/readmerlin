{
  "name": "readmerlin",
  "version": "0.8.3",
  "private": true,
  "description": "An agent skill that writes value-first READMEs for skill, agent and MCP server repos, and holds them to their rules.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "check": "node skills/readmerlin/scripts/readmerlin.mjs check README.md",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oficiallyAkshay/readmerlin.git"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
